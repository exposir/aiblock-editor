{
  "name": "aiblock-editor",
  "version": "0.2.5",
  "description": "A local-first block document editor with an AI-friendly CLI and desktop app.",
  "author": "AIBlock Editor contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/exposir/aiblock-editor.git"
  },
  "homepage": "https://github.com/exposir/aiblock-editor",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "electron:build": "node scripts/build-electron.mjs && vite build",
    "electron:dev": "node scripts/dev-electron.mjs",
    "electron:pack": "pnpm electron:build && electron-builder --dir",
    "electron:dist": "pnpm electron:build && electron-builder --mac dmg --arm64",
    "cli:build": "node scripts/build-cli.mjs",
    "cli": "node scripts/run-cli.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-code": "3.35.0",
    "@tiptap/extension-code-block": "3.35.0",
    "@tiptap/extension-color": "3.35.0",
    "@tiptap/extension-highlight": "3.35.0",
    "@tiptap/extension-link": "3.35.0",
    "@tiptap/extension-placeholder": "3.35.0",
    "@tiptap/extension-table": "3.35.0",
    "@tiptap/extension-table-cell": "3.35.0",
    "@tiptap/extension-table-header": "3.35.0",
    "@tiptap/extension-table-row": "3.35.0",
    "@tiptap/extension-task-item": "3.35.0",
    "@tiptap/extension-task-list": "3.35.0",
    "@tiptap/extension-text-style": "3.35.0",
    "@tiptap/extension-underline": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@tiptap/suggestion": "3.35.0",
    "katex": "0.19.1",
    "lowlight": "3.3.0",
    "lucide-react": "1.78.0",
    "marked": "18.3.0",
    "mermaid": "12.3.0",
    "pinyin-pro": "3.29.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.11.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vite": "7.3.8",
    "vitepress": "1.6.4",
    "vitest": "5.1.1"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "com.aiblockeditor.desktop",
    "productName": "AIBlock Editor",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!node_modules/**"
    ],
    "npmRebuild": false,
    "mac": {
      "icon": "build/icon.icns",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "notarize": false
    }
  },
  "bin": {
    "aiblock-doc": "./dist-cli/aiblock-doc.mjs"
  }
}
